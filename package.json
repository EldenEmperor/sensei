{
  "name": "sensei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sensei — terminal AI agent for log debugging (TypeScript variant)",
  "bin": {
    "sensei": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "pretest": "node scripts/make-test-log.mjs --if-missing",
    "dev": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "ink": "^7.1.1",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
